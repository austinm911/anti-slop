{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "anti-slop",
  "homepage": "https://github.com/austinm911/anti-slop",
  "items": [
    {
      "name": "no-return-local-alias-function",
      "type": "registry:item",
      "title": "No return local alias function",
      "description": "Install the local-alias return rule, its tests, and the ast-grep setup.",
      "devDependencies": ["@ast-grep/cli@0.45.0"],
      "files": [
        {
          "path": "ast-grep/sgconfig.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/sgconfig.yml"
        },
        {
          "path": "ast-grep/rules/no-return-local-alias-function.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rules/no-return-local-alias-function.yml"
        },
        {
          "path": "ast-grep/rule-tests/no-return-local-alias-function-test.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rule-tests/no-return-local-alias-function-test.yml"
        },
        {
          "path": "ast-grep/rule-tests/no-return-local-alias-function-tsx-test.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rule-tests/no-return-local-alias-function-tsx-test.yml"
        }
      ]
    },
    {
      "name": "no-throw-local-alias-function",
      "type": "registry:item",
      "title": "No throw local alias function",
      "description": "Install the local-alias throw rule, its tests, and the ast-grep setup.",
      "devDependencies": ["@ast-grep/cli@0.45.0"],
      "files": [
        {
          "path": "ast-grep/sgconfig.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/sgconfig.yml"
        },
        {
          "path": "ast-grep/rules/no-throw-local-alias-function.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rules/no-throw-local-alias-function.yml"
        },
        {
          "path": "ast-grep/rule-tests/no-throw-local-alias-function-test.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rule-tests/no-throw-local-alias-function-test.yml"
        },
        {
          "path": "ast-grep/rule-tests/no-throw-local-alias-function-tsx-test.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rule-tests/no-throw-local-alias-function-tsx-test.yml"
        }
      ]
    },
    {
      "name": "no-file-local-generic-record-guard",
      "type": "registry:item",
      "title": "No file-local generic record guard",
      "description": "Install the file-local isRecord guard rule, its tests, and the ast-grep setup.",
      "devDependencies": ["@ast-grep/cli@0.45.0"],
      "files": [
        {
          "path": "ast-grep/sgconfig.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/sgconfig.yml"
        },
        {
          "path": "ast-grep/rules/no-file-local-generic-record-guard.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rules/no-file-local-generic-record-guard.yml"
        },
        {
          "path": "ast-grep/rule-tests/no-file-local-generic-record-guard-test.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rule-tests/no-file-local-generic-record-guard-test.yml"
        },
        {
          "path": "ast-grep/rule-tests/no-file-local-generic-record-guard-tsx-test.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rule-tests/no-file-local-generic-record-guard-tsx-test.yml"
        }
      ]
    },
    {
      "name": "no-record-string-unknown",
      "type": "registry:item",
      "title": "No Record string unknown",
      "description": "Install the Oxlint rule for Record<string, unknown>, its test, and the ast-grep supplement for comment-formatted instances.",
      "devDependencies": ["oxlint@1.77.0", "@ast-grep/cli@0.45.0"],
      "files": [
        {
          "path": "oxlint/.oxlintrc.json",
          "type": "registry:file",
          "target": "~/tools/oxlint/.oxlintrc.json"
        },
        {
          "path": "oxlint/test.mjs",
          "type": "registry:file",
          "target": "~/tools/oxlint/test.mjs"
        },
        {
          "path": "ast-grep/sgconfig.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/sgconfig.yml"
        },
        {
          "path": "ast-grep/rules/no-commented-record-string-unknown.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rules/no-commented-record-string-unknown.yml"
        },
        {
          "path": "ast-grep/rule-tests/no-commented-record-string-unknown-test.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rule-tests/no-commented-record-string-unknown-test.yml"
        },
        {
          "path": "ast-grep/rule-tests/no-commented-record-string-unknown-tsx-test.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/rule-tests/no-commented-record-string-unknown-tsx-test.yml"
        }
      ]
    },
    {
      "name": "no-mixed-jsdoc-line-prefix",
      "type": "registry:item",
      "title": "No mixed JSDoc line prefix",
      "description": "Install the mixed JSDoc line-prefix preference, its tests, and the ast-grep setup.",
      "devDependencies": ["@ast-grep/cli@0.45.0"],
      "files": [
        {
          "path": "ast-grep/sgconfig.preferences.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/sgconfig.preferences.yml"
        },
        {
          "path": "ast-grep/preferences/no-mixed-jsdoc-line-prefix.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/preferences/no-mixed-jsdoc-line-prefix.yml"
        },
        {
          "path": "ast-grep/preference-tests/no-mixed-jsdoc-line-prefix-test.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/preference-tests/no-mixed-jsdoc-line-prefix-test.yml"
        },
        {
          "path": "ast-grep/preference-tests/no-mixed-jsdoc-line-prefix-tsx-test.yml",
          "type": "registry:file",
          "target": "~/tools/ast-grep/preference-tests/no-mixed-jsdoc-line-prefix-tsx-test.yml"
        }
      ]
    },
    {
      "name": "ast-grep",
      "type": "registry:item",
      "title": "Ast-grep rules",
      "description": "Install the three ast-grep rules.",
      "registryDependencies": [
        "austinm911/anti-slop/no-return-local-alias-function",
        "austinm911/anti-slop/no-throw-local-alias-function",
        "austinm911/anti-slop/no-file-local-generic-record-guard"
      ]
    },
    {
      "name": "oxlint",
      "type": "registry:item",
      "title": "Oxlint rules",
      "description": "Install the Oxlint rule.",
      "registryDependencies": ["austinm911/anti-slop/no-record-string-unknown"]
    },
    {
      "name": "recommended",
      "type": "registry:item",
      "title": "Recommended anti-slop rules",
      "description": "Install the recommended ast-grep and Oxlint rules.",
      "registryDependencies": ["austinm911/anti-slop/ast-grep", "austinm911/anti-slop/oxlint"]
    },
    {
      "name": "preferences",
      "type": "registry:item",
      "title": "Anti-slop preferences",
      "description": "Install the recommended JSDoc preference.",
      "registryDependencies": ["austinm911/anti-slop/no-mixed-jsdoc-line-prefix"]
    },
    {
      "name": "omp-ttsr",
      "type": "registry:item",
      "title": "Optional OMP TTSR guards",
      "description": "Install optional OMP stream guards for anti-slop diagnostics before lint runs.",
      "files": [
        {
          "path": "omp/rules/no-record-string-unknown.md",
          "type": "registry:file",
          "target": "~/.omp/rules/no-record-string-unknown.md"
        }
      ]
    }
  ]
}
