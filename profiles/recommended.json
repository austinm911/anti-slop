{
  "description": "Oxlint correctness, nkzw's stricter native picks, our rules, and portable TypeScript rules from dmmulroy and oxray.",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "rule:approx-constant": "error",
    "rule:array-callback-return": "warn",
    "rule:bad-bitwise-operator": "warn",
    "rule:complex-file-header": "warn",
    "rule:consistent-empty-array-spread": "warn",
    "rule:consistent-function-scoping": "error",
    "rule:eqeqeq": "warn",
    "rule:filename-match-export": "warn",
    "rule:misrefactored-assign-op": "error",
    "rule:no-abusive-eslint-disable": "warn",
    "rule:no-array-constructor": "warn",
    "rule:no-array-filter-map": "warn",
    "rule:no-case-declarations": "warn",
    "rule:no-chained-type-assertions": "warn",
    "rule:no-conditional-empty-object-spread": "warn",
    "rule:no-console": "warn",
    "rule:no-empty": "warn",
    "rule:no-empty-object-type": "warn",
    "rule:no-explicit-any": "warn",
    "rule:no-exported-function-expressions": "warn",
    "rule:no-extra-bind": "error",
    "rule:no-fallthrough": "warn",
    "rule:no-file-local-generic-record-guard": "error",
    "rule:no-hex-escape": "warn",
    "rule:no-implied-eval": "error",
    "rule:no-known-value-widening": "warn",
    "rule:no-magic-array-flat-depth": "warn",
    "rule:no-new-wrappers": "warn",
    "rule:no-non-null-asserted-nullish-coalescing": "warn",
    "rule:no-object-parameters": "warn",
    "rule:no-prototype-builtins": "warn",
    "rule:no-record-string-unknown": "warn",
    "rule:no-redeclare": "warn",
    "rule:no-reduce-accumulator-copy": "warn",
    "rule:no-reflect-apply": "warn",
    "rule:no-reflect-get": "warn",
    "rule:no-regex-spaces": "warn",
    "rule:no-require-imports": "warn",
    "rule:no-return-local-alias-function": "error",
    "rule:no-runtime-typeof": "warn",
    "rule:no-self-compare": "warn",
    "rule:no-shape-in-symbol-names": "warn",
    "rule:no-throw-literal": "warn",
    "rule:no-throw-local-alias-function": "error",
    "rule:no-type-erasure": "warn",
    "rule:no-typeof": "warn",
    "rule:no-typeof-undefined": "warn",
    "rule:no-unexpected-multiline": "error",
    "rule:no-unknown-parameters": "warn",
    "rule:no-unknown-returns": "warn",
    "rule:no-unknown-type-aliases": "warn",
    "rule:no-unnecessary-slice-end": "warn",
    "rule:no-unnecessary-type-constraint": "error",
    "rule:no-unsafe-dictionary-type": "warn",
    "rule:no-unsafe-function-type": "warn",
    "rule:no-useless-promise-resolve-reject": "warn",
    "rule:no-var": "warn",
    "rule:no-warning-comments": "warn",
    "rule:no-widen-then-assert": "warn",
    "rule:prefer-array-flat-map": "warn",
    "rule:prefer-array-some": "warn",
    "rule:prefer-at": "warn",
    "rule:prefer-dom-node-append": "warn",
    "rule:prefer-import-meta-properties": "warn",
    "rule:prefer-native-coercion-functions": "warn",
    "rule:prefer-node-protocol": "warn",
    "rule:prefer-number-properties": "warn",
    "rule:prefer-single-call": "warn",
    "rule:prefer-string-replace-all": "warn",
    "rule:prefer-string-slice": "warn",
    "rule:prefer-top-level-await": "warn",
    "rule:preserve-caught-error": "error",
    "rule:require-jsdoc-comments": "warn",
    "rule:require-readable-spacing": "warn",
    "rule:require-safety-comment-for-type-assertion": "warn"
  }
}
