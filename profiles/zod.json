{
  "description": "Recommended plus oxray's Zod 4 rules.",
  "extends": ["recommended"],
  "rules": {
    "rule:cross-field-issue-without-path": "error",
    "rule:file-organization": "error",
    "rule:json-parse-argument-of-safeparse": "error",
    "rule:no-json-parse-stringify-codec": "error",
    "rule:no-zod-type-erasure": "error",
    "rule:number-int-method": "error",
    "rule:object-strict-method": "error",
    "rule:optional-default-redundant": "error",
    "rule:record-string-unknown": "error",
    "rule:shape-spread-drops-refinements": "error",
    "rule:throwing-zod-refine": "error",
    "rule:tool-input-integer-as-number": "error",
    "rule:tool-input-not-strict": "error",
    "rule:trim-after-string-constraint": "error",
    "rule:union-of-literals-to-literal-array": "error",
    "rule:zinfer-instead-of-zoutput": "error",
    "rule:zod3-string-format-method": "error",
    "rule:zodtype-annotation-instead-of-satisfies": "error",
    "rule:zodtype-t-generic-helper": "error"
  }
}
