{
  "description": "Recommended plus nkzw's React, accessibility, and React Compiler picks and typeonce's React rules.",
  "extends": ["recommended"],
  "rules": {
    "rule:button-has-type": "warn",
    "rule:checked-requires-onchange-or-readonly": "warn",
    "rule:display-name": "warn",
    "rule:error-boundaries": "error",
    "rule:exhaustive-deps": "error",
    "rule:globals": "error",
    "rule:immutability": "error",
    "rule:incompatible-library": "error",
    "rule:jsx-key": "error",
    "rule:jsx-no-comment-textnodes": "error",
    "rule:jsx-no-duplicate-props": "error",
    "rule:jsx-no-script-url": "error",
    "rule:jsx-no-target-blank": "warn",
    "rule:jsx-no-undef": "error",
    "rule:jsx-props-no-spread-multi": "error",
    "rule:no-children-prop": "error",
    "rule:no-danger-with-children": "error",
    "rule:no-direct-mutation-state": "error",
    "rule:no-find-dom-node": "error",
    "rule:no-fixed-height-on-content": "error",
    "rule:no-is-mounted": "error",
    "rule:no-jsx-style": "error",
    "rule:no-react-component-inner-functions": "error",
    "rule:no-react-non-component-function-exports": "error",
    "rule:no-react-state-hooks": "error",
    "rule:no-render-return-value": "error",
    "rule:no-string-refs": "error",
    "rule:no-unescaped-entities": "warn",
    "rule:no-unknown-property": "warn",
    "rule:preserve-manual-memoization": "error",
    "rule:purity": "error",
    "rule:refs": "error",
    "rule:require-default-component-export": "error",
    "rule:rules-of-hooks": "warn",
    "rule:set-state-in-effect": "error",
    "rule:set-state-in-render": "error",
    "rule:static-components": "error",
    "rule:unsupported-syntax": "error",
    "rule:use-memo": "error",
    "rule:void-dom-elements-no-children": "error"
  }
}
