{
  "name": "@austinm911/anti-slop",
  "version": "0.1.0",
  "description": "GitHub source registry of structural ast-grep and Oxlint rules",
  "homepage": "https://github.com/austinm911/anti-slop#readme",
  "bugs": "https://github.com/austinm911/anti-slop/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austinm911/anti-slop.git"
  },
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run rules:test && bun run typecheck && bun run discovery:test && bun run review:test && bun run registry:check",
    "discovery:discover": "bun scripts/discovery/cli.ts discover",
    "discovery:report": "bun scripts/discovery/cli.ts report",
    "discovery:test": "bun test scripts/discovery",
    "discovery:triage": "bun scripts/discovery/cli.ts triage",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "registry:check": "shadcn registry validate registry.json",
    "review": "bun scripts/review/server.ts",
    "review:test": "bun test scripts/review",
    "rules:test": "ast-grep test --config ast-grep/sgconfig.yml --skip-snapshot-tests && ast-grep test --config ast-grep/sgconfig.preferences.yml --skip-snapshot-tests && node oxlint/test.mjs",
    "typecheck": "tsc -p tsconfig.discovery.json"
  },
  "dependencies": {
    "@ast-grep/cli": "0.45.0",
    "oxlint": "1.77.0"
  },
  "devDependencies": {
    "@astryxdesign/core": "0.1.9",
    "@astryxdesign/theme-neutral": "0.1.9",
    "@types/bun": "1.3.14",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "oxfmt": "0.61.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "shadcn": "4.16.1",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
